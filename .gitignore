# ============================
.gradle/
build/
*/build/
*.apk
*.aab
*.ap_
*.dex
*.class
*.jar
*.war
*.ear
local.properties
*.log
*.log.*

# Gradle cache & wrapper
.gradle/
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.properties

# Captures d'écran & métadonnées
captures/
*.png
*.jpg
*.jpeg

# Lint
lint-results*.xml
lint/
lint-results-*.html

# C++ / NDK
.cxx/
.externalNativeBuild/

# Signing
*.keystore
*.jks

